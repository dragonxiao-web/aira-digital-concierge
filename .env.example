# Anthropic API — leave ANTHROPIC_API_KEY unset if you've run `ant auth login`
ANTHROPIC_API_KEY=

# Model used for both the intent classifier and the Q&A function
CLAUDE_MODEL=claude-sonnet-5

# Slack bot token (starts with xoxb-) and the channel to post staff alerts to.
# Leave SLACK_BOT_TOKEN unset in dev — Slack calls are best-effort and never
# block the guest-facing response (see src/slack.js).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#concierge-alerts

# Signing secret from your Slack app's "Basic Information" page — required
# to verify that POST /slack/actions requests (the Mark Completed / Not Yet
# buttons) actually came from Slack. Without this set, that endpoint
# rejects every request with 401.
SLACK_SIGNING_SECRET=

# Port the Express server listens on
PORT=3000

# CORS: set to your real hotel domain in production, e.g. https://sunsetbayhotel.com
# Defaults to * (any origin) which is fine for local testing.
CORS_ORIGIN=*

# SQLite file location (relative to project root)
DB_PATH=./data/concierge.db

# Required. Encryption-at-rest key for the SQLite database (SQLCipher-
# compatible AES-256, via better-sqlite3-multiple-ciphers). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be a 64-character hex string. Losing this key means losing the data —
# store it the same way you'd store any other production secret, not just
# in this file. The server refuses to start without it.
DB_ENCRYPTION_KEY=

# Required. Bearer token staff/monitoring tools must send to call the
# /tickets endpoints (they expose guest names, room numbers, and message
# content). Generate the same way as DB_ENCRYPTION_KEY. The server refuses
# to start without it. Send as: Authorization: Bearer <this value>
STAFF_API_KEY=
